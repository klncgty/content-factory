# OpenRouter — tüm LLM çağrıları (config/models.yaml ile agent başına model seçilir)
OPENROUTER_API_KEY=

# Görsel üretim sağlayıcısı (config/models.yaml -> agents.image_generator.provider ile eşleşmeli)
# OPSİYONEL: provider "openrouter" ise boş bırakılabilir — OPENROUTER_API_KEY'e düşülür
# (görsel ve metin aynı hesaptan faturalanır). Yalnızca ayrı bir sağlayıcıya
# (Imagen, Flux vb.) geçildiğinde doldurulur.
IMAGE_API_KEY=

# oleart.co reposuna push için (sınırlı yetkili deploy token önerilir)
GIT_TOKEN=

# Opsiyonel — Faz 2 NotifierAgent
NOTIFY_WEBHOOK_URL=

# Opsiyonel — Faz 3 geri besleme döngüsü
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=
