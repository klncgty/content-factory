# OpenRouter — tüm LLM çağrıları (config/models.yaml ile agent başına model seçilir)
OPENROUTER_API_KEY=

# Görsel üretimi — Google AI Studio (Gemini API), varsayılan sağlayıcı
# config/models.yaml -> agents.image_generator.provider: google-ai-studio
# https://aistudio.google.com/apikey adresinden alınır. GOOGLE_API_KEY de kabul edilir.
GEMINI_API_KEY=

# Görsel üretimi — yalnızca provider "openrouter" olarak değiştirilirse gerekir.
# Boş bırakılırsa OPENROUTER_API_KEY'e düşülür (görsel ve metin aynı hesaptan faturalanır).
IMAGE_API_KEY=

# HEDEF repoya (brands/{marka}/publish.yaml -> target_repo_path'in remote'u, ör.
# github.com/klncgty/oleart) push ve PR açmak için. Bu projenin kendi reposu DEĞİL.
#
# GitHub > Settings > Developer settings > Personal access tokens > Fine-grained tokens
#   Repository access : yalnızca hedef repo
#   Permissions       : Contents = Read and write, Pull requests = Read and write
#
# Tanımlıysa push token'lı URL ile yapılır ve PR doğrudan GitHub API'sine açılır — yani
# yayın adımı makinedeki interaktif git/gh oturumuna bağlı olmaz (sunucu/CI'da da çalışır).
# Boş bırakılırsa mevcut git kimliğiyle push denenir, PR için `gh` CLI aranır.
GIT_TOKEN=

# Opsiyonel — Faz 2 NotifierAgent
NOTIFY_WEBHOOK_URL=

# Opsiyonel — Faz 3 geri besleme döngüsü
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=
